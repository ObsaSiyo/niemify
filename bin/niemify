#!/usr/bin/env lua

local niemify = require('niemify')
local schema = require('niemify.schema')
local json = require('dkjson')
local lfs = require('lfs')

local help = [[niemify — Convert XML and JSON. Validate against XSD.

Usage: niemify <command> [options]

Convert and validate
  convert   Convert XML to JSON, or JSON to XML
  verify    Validate XML against an XSD

Manage local schemas
  list      See built-in and registered schemas
  upload    Register a local XSD
  update    Replace a registered XSD
  switch    Set the active schema
  config    Show local configuration
  setup     Initialize local configuration

Options
  -h, --help      Show help
  -v, --version   Print the version

Run niemify help <command> for usage and examples.]]

local commands = {
  convert = { 2, '<input.xml|input.json> <output|-> [--schema <name>]',
    'The input extension determines the output format. Use - for stdout.\nExisting output files are never overwritten.',
    'niemify convert exchange.xml exchange.json --schema exchange-demo' },
  verify = { 1, '<input.xml> [--schema <name>]',
    'Uses the active schema unless --schema is supplied.',
    'niemify verify exchange.xml --schema exchange-demo' },
  list = { 0, '', 'Print built-in and registered schema names as JSON.', 'niemify list' },
  upload = { 2, '<name> <schema.xsd>',
    'Register a trusted local XSD in place so relative imports still work.',
    'niemify upload inventory examples/inventory/exchange.xsd' },
  update = { 2, '<name> <schema.xsd>',
    'Point an existing registration at a different local XSD.',
    'niemify update inventory ./schemas/new-exchange.xsd' },
  switch = { 1, '<name>', 'Set the schema used by verify when no --schema is supplied.', 'niemify switch exchange-demo' },
  config = { 0, '', 'Print the active schema and local registrations as JSON.', 'niemify config' },
  setup = { 0, '', 'Initialize local configuration without removing existing registrations.', 'niemify setup' },
}

local function usage(command)
  local operands = commands[command][2]
  return 'Usage: niemify ' .. command .. (operands == '' and '' or ' ' .. operands)
end

local function show_help(command)
  if not command or command == 'help' then return print(help) end
  local entry = commands[command]
  if not entry then error('Unknown command: ' .. command .. '. Run niemify --help.', 0) end
  print(usage(command) .. '\n\n' .. entry[3] .. '\n\nExample:\n  ' .. entry[4])
end

local actions = {
  setup = schema.setup, config = schema.config, list = schema.list,
  upload = schema.upload, update = schema.update, switch = schema.switch,
}

local function read(path)
  local file <close> = assert(io.open(path, 'rb'))
  return assert(file:read('a'))
end

local function write_new(path, data)
  local function existing_output()
    error('Output already exists: ' .. path .. '\nHint: choose another output path, or use - for stdout.', 0)
  end
  if lfs.symlinkattributes(path) then existing_output() end
  local nonce = os.tmpname()
  os.remove(nonce)
  local directory = (path:match('^(.*/)') or './') .. '.niemify-' .. assert(nonce:match('[^/]+$'))
  assert(lfs.mkdir(directory))
  local staged = directory .. '/output'
  local ok, err = pcall(function()
    local file <close> = assert(io.open(staged, 'wb'))
    assert(file:write(data, '\n'))
    assert(file:flush())
  end)
  local collision
  if ok then
    ok, err = lfs.link(staged, path)
    collision = not ok and lfs.symlinkattributes(path)
  end
  os.remove(staged)
  lfs.rmdir(directory)
  if collision then existing_output() end
  if not ok then error(err, 0) end
end

local function parse(args)
  local positional, selected, show_help_flag, version_flag, flags = {}, nil, false, false, true
  local i = 1
  while i <= #args do
    local arg = args[i]
    if flags and arg == '--' then
      flags = false
    elseif flags and (arg == '--help' or arg == '-h') then
      show_help_flag = true
    elseif flags and (arg == '--version' or arg == '-v') then
      version_flag = true
    elseif flags and arg == '--schema' then
      if selected then error('--schema can only be provided once', 0) end
      i = i + 1
      selected = args[i]
      if not selected or selected == '' or selected:sub(1, 1) == '-' then error('--schema requires a name', 0) end
    elseif flags and arg ~= '-' and arg:sub(1, 1) == '-' then
      error('Unknown option: ' .. arg, 0)
    else
      positional[#positional + 1] = arg
    end
    i = i + 1
  end
  return positional, selected, show_help_flag, version_flag
end

local function main(args)
  local operands, selected, help_flag, version_flag = parse(args)
  local command = table.remove(operands, 1)
  if version_flag or command == 'version' then return print(niemify.version) end
  if command == 'help' then
    if #operands > 1 then error('Usage: niemify help [command]', 0) end
    return show_help(operands[1])
  end
  if help_flag or not command then return show_help(command) end
  local spec = commands[command]
  if not spec then error('Unknown command: ' .. command .. '. Run niemify --help.', 0) end
  if #operands ~= spec[1] then
    error(('%s expects %d argument%s.\n%s'):format(command, spec[1], spec[1] == 1 and '' or 's', usage(command)), 0)
  end
  if selected and command ~= 'convert' and command ~= 'verify' then
    error('--schema is only supported by convert and verify.\n' .. usage(command), 0)
  end
  if command == 'convert' then
    local input, output = table.unpack(operands)
    local format = input:lower():match('%.([^.]+)$')
    if format ~= 'xml' and format ~= 'json' then
      error('The input must have a .xml or .json extension.\n' .. usage(command), 0)
    end
    local result = niemify.convert(read(input), format, { schema = selected })
    if format == 'xml' then result = assert(json.encode(result, { indent = true })) end
    if output == '-' then
      print(result)
    else
      write_new(output, result)
      io.stderr:write('Wrote ', output, format == 'xml' and ' (XML to JSON).\n' or ' (JSON to XML).\n')
    end
  elseif command == 'verify' then
    niemify.validate(read(operands[1]), 'xml', { validate = true, schema = selected })
    print('Valid')
  else
    print(assert(json.encode(actions[command](table.unpack(operands)), { indent = true })))
  end
end

local ok, err = pcall(main, arg)
if not ok then
  io.stderr:write('niemify: ', tostring(err), '\n')
  os.exit(1)
end
